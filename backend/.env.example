# VoxGuard Backend Environment Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Audio Processing Constraints
MAX_UPLOAD_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=300.0
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.m4a,.aac,.webm,.opus,.wma,.aiff,.aif,.caf,.amr,.3gp,.mp4
ALLOWED_MIME_TYPES=audio/wav,audio/mpeg,audio/flac,audio/ogg,audio/mp4,audio/webm
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# ML Model Configuration
MODEL_ENABLED=true
MODEL_PATH=models/best_model.pt
MODEL_NAME=VoxGuard Neural Deepfake Classifier
MODEL_VERSION=1.0.0
MODEL_TYPE=pytorch
